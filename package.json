{
  "name": "ghostledger",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ghostledger/web",
    "build": "npm run build -w @ghostledger/web",
    "preview": "npm run preview -w @ghostledger/web",
    "test": "npm run test -w @ghostledger/core",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
