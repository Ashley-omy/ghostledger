# Copy this file to .env and fill in your own values. Never commit .env.
DEFAULT_MODE=online

# Online mode (Gemini API). Leave GEMINI_API_KEY empty to use Offline mode only.
GEMINI_API_KEY=
EXTRACT_MODEL=gemma-4-26b-a4b-it
INSIGHT_MODEL=gemma-4-31b-it

# Offline mode (Ollama API)
OLLAMA_HOST=http://ollama:11434
LOCAL_MODEL=gemma4:e2b

APP_PASSWORD=
DATA_DIR=/data
